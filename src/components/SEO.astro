---
interface Props {
  title?: string;
  description?: string;
  lang: string;
  noindex?: boolean;
}

const seoDefaults: Record<string, { title: string; description: string; locale: string }> = {
  ja: {
    title: "QRメーカー | 絵文字入り・角丸デザインQR生成",
    description: "登録不要・無料で高機能なQRコードが作れます。絵文字の配置、角丸、色のカスタマイズに対応。オフラインでも動作し、SVG/PNG保存が可能です。",
    locale: "ja_JP",
  },
  en: {
    title: "QR Maker | Design Custom QR with Emojis",
    description: "Generate high-quality custom QR codes for free. Supports emojis, rounded corners, and custom colors. Works offline with SVG/PNG export.",
    locale: "en_US",
  },
  zh: {
    title: "QR 生成器 | 带表情符号和圆角设计的二维码",
    description: "免费创建高质量自定义二维码。支持表情符号、圆角和自定义颜色。支持离线使用，可导出SVG/PNG。",
    locale: "zh_CN",
  },
  es: {
    title: "QR Maker | Crea Códigos QR Personalizados con Emojis",
    description: "Genera códigos QR personalizados de alta calidad gratis. Admite emojis, esquinas redondeadas y colores personalizados. Funciona sin conexión con exportación SVG/PNG.",
    locale: "es_ES",
  },
};

const defaults = seoDefaults[Astro.props.lang] || seoDefaults.en;

const {
  lang,
  title = defaults.title,
  description = defaults.description,
  noindex = false,
} = Astro.props;

const locale = (seoDefaults[lang] || seoDefaults.en).locale;

const siteUrl = "https://qr.manpuc.me";
const canonicalURL = new URL(Astro.url.pathname.replace(/\/$/, ""), siteUrl)
  .href;

// 言語ごとのOG画像パス
const ogImageMap: Record<string, string> = {
  ja: "/og/og-image_jp.png",
  en: "/og/og-image_en.png",
  zh: "/og/og-image_zh.png",
  es: "/og/og-image_es.png",
};
const ogImage = new URL(ogImageMap[lang] || "/og/og-image_jp.png", siteUrl).href;

// 多言語パスの定義
const alternateLinks = [
  { rel: "alternate", hreflang: "ja", href: siteUrl + "/" },
  { rel: "alternate", hreflang: "en", href: siteUrl + "/en/" },
  { rel: "alternate", hreflang: "zh", href: siteUrl + "/zh/" },
  { rel: "alternate", hreflang: "es", href: siteUrl + "/es/" },
  { rel: "alternate", hreflang: "x-default", href: siteUrl + "/" },
];

// パンくずの「ホーム」ラベル
const homeLabels: Record<string, string> = {
  ja: "ホーム", en: "Home", zh: "首页", es: "Inicio",
};

// JSON-LD data
const softwareData = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  name: title,
  description: description,
  operatingSystem: "All",
  applicationCategory: "DesignApplication",
  browserRequirements: "requires HTML5 support",
  url: siteUrl,
  author: {
    "@type": "Person",
    name: "manpuc",
    url: "https://manpuc.me",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "JPY",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    ratingCount: "1",
    bestRating: "5",
  },
};

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: homeLabels[lang] || "Home",
      item: siteUrl,
    },
  ],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/fav-128.ico" sizes="128x128" />
<link rel="apple-touch-icon" href="/app.png" />
<meta name="theme-color" content="#ffffff" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical & hreflang -->
<link rel="canonical" href={canonicalURL} />
{
  alternateLinks.map((link) => (
    <link rel={link.rel} hreflang={link.hreflang} href={link.href} />
  ))
}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={locale} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- Structured Data -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(softwareData)}
/>
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(breadcrumbData)}
/>
