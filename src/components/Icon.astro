---
import {
  Download,
  Copy,
  Trash,
  Settings,
  Share2,
  Languages,
  History,
  Sparkles,
  Palette,
  Sun,
  Moon,
  Check,
  Info,
  AlertTriangle,
  RotateCw,
} from "@lucide/astro";

const icons = {
  download: Download,
  copy: Copy,
  trash: Trash,
  gear: Settings,
  share: Share2,
  language: Languages,
  history: History,
  magic: Sparkles,
  palette: Palette,
  sun: Sun,
  moon: Moon,
  check: Check,
  info: Info,
  warning: AlertTriangle,
  rotate: RotateCw,
};

interface Props {
  name: keyof typeof icons;
  class?: string;
  id?: string;
  "aria-label"?: string;
  "aria-hidden"?: boolean | "true" | "false";
}

const {
  name,
  class: className = "",
  id,
  "aria-label": ariaLabel,
  "aria-hidden": ariaHidden,
} = Astro.props;

const IconComponent = icons[name as keyof typeof icons];
---

<span
  class={`inline-icon ${className}`}
  id={id}
  aria-label={ariaLabel}
  aria-hidden={ariaHidden === undefined && !ariaLabel ? "true" : ariaHidden}
>
  {IconComponent && <IconComponent width="1em" height="1em" stroke-width="2.5" />}
</span>

<style>
  .inline-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
    line-height: 1;
    flex-shrink: 0;
  }
  .inline-icon :global(svg) {
    width: 1em;
    height: 1em;
    display: block;
    color: currentColor; 
  }
</style>
