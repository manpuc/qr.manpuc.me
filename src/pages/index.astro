---
import Icon from "../components/Icon.astro";
import "../styles/global.css";

const title = "QRメーカー | QR maker";
const description =
  "高速・オフライン対応の多機能QRコード生成アプリ。プレビュー付きでデザインや絵文字埋め込みの設定が可能です。";
const url = "https://qr.manpuc.me/";
---

<html lang="ja" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking font loading with fallback to noscript -->
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/fav-128.ico" sizes="128x128" />
    <link rel="apple-touch-icon" href="/app.png" />
    <meta name="theme-color" content="#ffffff" />
    <!-- manifest is handled by @vite-pwa/astro automatically in head -->
    <meta name="astro-view-transitions-enabled" content="false" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="canonical" href={url} />
  </head>
  <body>
    <div class="top-controls">
      <button
        id="btn-lang"
        class="icon-btn"
        aria-label="Toggle Language"
        title="Change Language"><Icon name="language" /></button
      >
      <button
        id="btn-theme"
        class="icon-btn"
        aria-label="Toggle Theme"
        title="Switch Theme"
      >
        <Icon name="sun" class="theme-sun" />
        <Icon name="moon" class="theme-moon" />
      </button>
    </div>

    <div class="container">
      <header class="app-header">
        <img src="/favicon.svg" class="page-icon" alt="" />
        <h1 class="app-title" data-i18n="appTitle">QRメーカー</h1>
      </header>

      <main class="grid-layout">
        <div class="config-col">
          <div class="card">
            <h2 data-i18n="settingsTitle"><Icon name="gear" /> デザイン設定</h2>

            <div class="form-group">
              <label for="input-data" data-i18n="dataLabel"
                >データ (URLやテキスト)</label
              >
              <input
                type="text"
                id="input-data"
                data-i18n-placeholder="dataLabel"
              />
              <div
                id="text-warning"
                class="hidden"
                style="color: var(--color-warning); font-size: 0.8rem; margin-top: 4px; font-weight: 700;"
              >
                ⚠️
                日本語などマルチバイト文字は機種によっては文字化けする可能性があります。
              </div>
            </div>

            <div class="grid-2col">
              <div class="form-group">
                <label for="input-size" data-i18n="sizeLabel"
                  >出力サイズ (px)</label
                >
                <select id="input-size">
                  <option value="128">128</option>
                  <option value="256" selected>256</option>
                  <option value="512">512</option>
                  <option value="1024">1024</option>
                </select>
              </div>
              <div class="form-group">
                <label for="input-ec" data-i18n="errorCorrectionLabel"
                  >誤り訂正</label
                >
                <select id="input-ec">
                  <option value="L">L (7%)</option>
                  <option value="M" selected>M (15%)</option>
                  <option value="Q">Q (25%)</option>
                  <option value="H">H (30%)</option>
                </select>
              </div>
            </div>

            <div class="grid-2col">
              <div class="form-group">
                <label for="input-style" data-i18n="styleLabel"
                  >ドットスタイル</label
                >
                <select id="input-style">
                  <option value="square" data-i18n="styleSquare">四角</option>
                  <option value="dots" data-i18n="styleDots">丸</option>
                  <option value="rounded" selected data-i18n="styleRounded"
                    >角丸</option
                  >
                </select>
              </div>
              <div class="form-group">
                <label for="input-margin" data-i18n="marginLabel"
                  >余白枠 (px)</label
                >
                <input
                  type="number"
                  id="input-margin"
                  value="10"
                  min="0"
                  max="100"
                />
              </div>
            </div>

            <div class="grid-2col">
              <div class="form-group">
                <label for="input-fg" data-i18n="fgColorLabel">前景色</label>
                <div class="color-picker-wrap">
                  <input type="color" id="input-fg" value="#000000" />
                  <input
                    type="text"
                    id="input-fg-text"
                    value="#000000"
                    style="width:100%;"
                    data-i18n-aria-label="fgColorLabel"
                  />
                </div>
              </div>
              <div class="form-group">
                <label for="input-bg" data-i18n="bgColorLabel">背景色</label>
                <div class="color-picker-wrap">
                  <input type="color" id="input-bg" value="#ffffff" />
                  <input
                    type="text"
                    id="input-bg-text"
                    value="#ffffff"
                    style="width:100%;"
                    data-i18n-aria-label="bgColorLabel"
                  />
                </div>
              </div>
            </div>

            <div class="form-group">
              <label for="input-qr-radius" data-i18n="qrRadiusLabel"
                >QR全体の角丸</label
              >
              <input
                type="number"
                id="input-qr-radius"
                min="0"
                max="100"
                step="1"
                value="12"
              />
            </div>

            <div class="form-group">
              <label class="toggle-label">
                <input type="checkbox" id="input-transparent" />
                <span data-i18n="transparentBgLabel"
                  >背景を透過する (PNG保存用)</span
                >
              </label>
            </div>

            <hr
              style="margin: 20px 0; border: 0; border-top: 1px solid var(--color-border);"
            />

            <div class="form-group">
              <label for="input-emoji-mode" data-i18n="emojiModeLabel"
                >中央絵文字 (Noto)</label
              >
              <select id="input-emoji-mode">
                <option value="none" data-i18n="emojiNone">なし</option>
                <option value="text" data-i18n="emojiText"
                  >テキスト描画方式</option
                >
                <option value="image" data-i18n="emojiImage">画像化方式</option>
              </select>
            </div>

            <div class="form-group hidden" id="emoji-input-wrap">
              <label for="input-emoji" data-i18n="emojiInputLabel"
                >テキスト/絵文字入力</label
              >
              <input type="text" id="input-emoji" placeholder="🌟" value="🌟" />
              <div
                id="emoji-warning"
                class="hidden"
                style="color: var(--color-warning); font-size: 0.8rem; margin-top: 4px; font-weight: 700;"
              >
                ⚠️
                絵文字以外が入力されています。画像化方式では1文字の絵文字のみ推奨されます。
              </div>
            </div>

            <!-- グローバル共通コントロール (サイズと色相) -->
            <div
              id="emoji-common-controls"
              class="hidden"
              style="margin-bottom: 12px;"
            >
              <div
                class="form-group"
                style="margin-bottom: 12px;"
                id="emoji-size-wrap"
              >
                <label for="input-emoji-size">サイズ (Max 50%)</label>
                <div class="flex-row">
                  <input
                    type="range"
                    id="input-emoji-size"
                    min="10"
                    max="50"
                    value="40"
                    style="flex: 1;"
                  />
                  <span
                    id="val-emoji-size"
                    style="min-width: 3em; font-variant-numeric: tabular-nums;"
                    >40%</span
                  >
                </div>
              </div>
              <div
                class="form-group hidden"
                id="emoji-hue-wrap"
                style="margin-bottom: 12px;"
              >
                <label for="input-emoji-hue">色相 (Hue)</label>
                <div class="flex-row">
                  <input
                    type="range"
                    id="input-emoji-hue"
                    min="0"
                    max="360"
                    value="0"
                    style="flex: 1;"
                  />
                  <span
                    id="val-emoji-hue"
                    style="min-width: 3em; font-variant-numeric: tabular-nums;"
                    >0</span
                  >
                </div>
              </div>
            </div>

            <!-- テキスト描画方式専用コントロール -->
            <div id="emoji-text-controls" class="hidden">
              <div
                class="form-group"
                id="emoji-font-wrap"
                style="margin-bottom: 12px;"
              >
                <label for="input-emoji-font">フォント</label>
                <select id="input-emoji-font" style="width: 100%;">
                  <option value="sans-serif">ゴシック (sans-serif)</option>
                  <option value="serif">明朝 (serif)</option>
                  <option value="monospace">等幅 (monospace)</option>
                  <option value="'Zen Maru Gothic', sans-serif">Zen Maru</option
                  >
                </select>
              </div>
              <div
                class="form-group"
                id="emoji-weight-wrap"
                style="margin-bottom: 12px;"
              >
                <label for="input-emoji-weight">太さ</label>
                <div class="flex-row">
                  <input
                    type="range"
                    id="input-emoji-weight"
                    min="100"
                    max="900"
                    step="100"
                    value="700"
                    style="flex: 1;"
                  />
                  <span
                    id="val-emoji-weight"
                    style="min-width: 3em; font-variant-numeric: tabular-nums;"
                    >700</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="preview-col">
          <div
            class="card"
            style="text-align: center; position: sticky; top: 20px;"
          >
            <h2 data-i18n="previewTitle"><Icon name="magic" /> プレビュー</h2>
            <div
              id="qr-preview"
              class="qr-preview-wrapper"
              style="min-height: 256px;"
            >
              <!-- QR Code generated here -->
              <div
                class="qr-placeholder"
                style="width: 256px; height: 256px; opacity: 0.1; background: currentColor; border-radius: 12px; display: flex; align-items: center; justify-content: center;"
              >
                <img src="/favicon.svg" class="placeholder-icon" alt="" />
              </div>
            </div>

            <div id="readability-alert" class="alert hidden">
              <Icon name="check" id="alert-icon" />
              <span id="alert-text"></span>
            </div>

            <div class="flex-col" style="margin-top: 20px;">
              <button id="btn-dl-png"
                ><Icon name="download" />
                <span data-i18n="downloadPng">PNG 保存</span></button
              >
              <button id="btn-dl-svg" class="outline"
                ><Icon name="download" />
                <span data-i18n="downloadSvg">SVG 保存</span></button
              >
              <button id="btn-share" class="outline"
                ><Icon name="share" />
                <span data-i18n="shareLabel">共有 URL</span></button
              >
            </div>
          </div>
        </div>
      </main>

      <section
        class="card hidden"
        id="history-section"
        style="margin-top:20px;"
      >
        <h2 data-i18n="historyTitle"><Icon name="history" /> 履歴</h2>
        <div id="history-list" class="history-grid"></div>
      </section>

      <div style="text-align: center; margin-top: 40px; margin-bottom: 20px;">
        <a
          href="https://manpuc.me"
          target="_blank"
          rel="noopener noreferrer"
          class="branded-footer-link"
        >
          Developed with ❤️ by manpuc
        </a>
      </div>
    </div>

    <script>
      // Load PWA virtual module if available
      try {
        // @ts-ignore
        import("virtual:pwa-register").then(({ registerSW }) => {
          registerSW({ immediate: true });
        });
      } catch (e) {}
    </script>
    <script src="../scripts/main.ts"></script>
    <!-- Cloudflare Web Analytics at the end -->
    <script
      async
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "d6c3a0039b4e4cb194e7ea83521c8174"}'></script>

    <style>
      /* --- ヘッダー・ロゴのデザイン微調整 --- */
      .app-header {
        display: flex;
        align-items: center;
        gap: 12px; /* ロゴと文字の間隔 */

        /* 上下左右の余白を調整したい場合はここ */
        margin-top: 0px;
        margin-left: 0px;
        margin-bottom: 32px;
      }

      .branded-footer-link {
        font-size: 0.85rem;
        color: var(--color-text-muted);
        opacity: 0.5;
        transition:
          opacity 0.3s ease,
          color 0.3s ease,
          transform 0.3s ease;
        text-decoration: none;
        display: inline-block;
      }
      .branded-footer-link:hover {
        opacity: 1;
        color: var(--color-text);
        transform: scale(1.03);
      }

      .page-icon {
        /* ロゴのサイズ */
        width: 2.4rem;
        height: 2.4rem;

        /* ロゴの位置をさらに細かく(1px単位で)動かしたい場合 */
        position: relative;
        top: 0px; /* 正の数で下、負の数で上 */
        left: 0px; /* 正の数で右、負の数で左 */

        flex-shrink: 0;
      }

      .app-title {
        /* ロゴ横のテキストのサイズと太さ */
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
        line-height: 1;

        /* テキストの位置をさらに細かく(1px単位で)動かしたい場合 */
        position: relative;
        top: -1px; /* 正の数で下、負の数で上 */
        left: 0px; /* 正の数で右、負の数で左 */

        /* 文字の間隔(カーニング)を調整したい場合 */
        letter-spacing: -0.02em;
      }

      .placeholder-icon {
        width: 64px;
        height: 64px;
      }
      .grid-layout {
        display: flex;
        gap: 24px;
        flex-direction: column;
      }
      @media (min-width: 768px) {
        .grid-layout {
          flex-direction: row;
          align-items: flex-start;
        }
        .config-col {
          flex: 1.2;
        }
        .preview-col {
          flex: 1;
        }
      }
      .grid-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      /* iOS 26 Dynamic Alert: Full Background Color */
      .alert {
        margin-top: 24px;
        padding: 20px;
        border-radius: var(--radius-md);
        font-size: 0.95rem;
        font-weight: 700;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        text-align: left;
        transition: all var(--transition-bounce);
        animation: slideDown 0.6s var(--spring-bounce);
        border: none;
      }
      @keyframes slideDown {
        0% {
          opacity: 0;
          transform: translateY(-20px) scale(0.95);
        }
        100% {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .alert.safe {
        background-color: var(--color-success);
        color: #ffffff;
      }
      .alert.warning {
        background-color: var(--color-warning);
        color: #000000;
      }
      .alert.danger {
        background-color: var(--color-danger);
        color: #ffffff;
      }

      /* Refined History Management (List/Card Hybrid) */
      .history-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        margin-top: 20px;
      }
      @media (min-width: 600px) {
        .history-grid {
          grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        }
      }

      .history-item {
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: 20px;
        background: var(--color-surface);
        transition:
          transform var(--transition-fast),
          box-shadow var(--transition-fast);
        position: relative;
        display: flex;
        align-items: center;
        gap: 16px;
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
      }
      .history-item:hover {
        background-color: var(--color-surface-hover);
        border-color: var(--color-text);
      }

      .history-preview-mini {
        width: 60px;
        height: 60px;
        background: white;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--color-border);
        flex-shrink: 0;
      }
      .history-item-content {
        flex: 1;
        min-width: 0;
      }
      .history-item-date {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        margin-bottom: 4px;
      }
      .history-item-data {
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 1rem;
        color: var(--color-text);
      }

      .history-actions {
        display: flex;
        gap: 8px;
        margin-top: 8px;
      }
      .history-action-btn {
        padding: 6px 12px;
        font-size: 0.75rem;
        border-radius: var(--radius-full);
        background: var(--color-bg);
        color: var(--color-text);
        border: 1px solid var(--color-border);
      }
      .history-action-btn:hover {
        background: var(--color-text);
        color: var(--color-bg);
        transform: scale(1.05);
      }

      .history-item-delete {
        color: var(--color-text-muted);
        cursor: pointer;
        padding: 4px;
        transition: color 0.2s;
      }
      .history-item-delete:hover {
        color: var(--color-accent-red);
        transform: scale(1.2);
      }
    </style>
  </body>
</html>
