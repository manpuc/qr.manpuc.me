<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>QR Maker</title>
    <script is:inline>
      (function () {
        if (window.location.pathname !== "/" && window.location.pathname !== "/index.html") return;
        var supported = ["ja", "en", "zh", "es"];
        var lang = "";
        try {
          var saved = localStorage.getItem("qr_maker_lang");
          if (saved && supported.indexOf(saved) !== -1) lang = saved;
        } catch (e) {}
        if (!lang) {
          var nav = (navigator.languages && navigator.languages[0]) || navigator.language || "";
          var lower = nav.toLowerCase();
          if (lower.indexOf("ja") === 0) lang = "ja";
          else if (lower.indexOf("zh") === 0) lang = "zh";
          else if (lower.indexOf("es") === 0) lang = "es";
          else lang = "en";
        }
        window.location.replace("/" + lang + "/" + window.location.search + window.location.hash);
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/ja/" />
    </noscript>
  </head>
  <body></body>
</html>
