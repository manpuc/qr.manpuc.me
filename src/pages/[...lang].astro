---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Select from "../components/Select.astro";
import Slider from "../components/Slider.astro";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // Root (ja)
    { params: { lang: "en" } }, // English
    { params: { lang: "zh" } }, // Chinese
    { params: { lang: "es" } }, // Spanish
  ];
}

const { lang: langParam } = Astro.params;
const lang = langParam || "ja";

// SSR side i18n text lookup
const pageText: Record<string, { title: string; description: string }> = {
  ja: {
    title: "QRメーカー | 絵文字入り・角丸デザインQRコード生成",
    description: "登録不要・完全クライアントサイドで動作する高機能QRコードスタジオ。Monolith UIデザイン、リアルタイムプレビュー、絵文字やドットスタイルのカスタマイズ、SVG/PNG保存に対応。",
  },
  en: {
    title: "QR Maker | Custom Design QR Code Generator with Emojis",
    description: "Client-side, privacy-first QR code studio. Monolith UI components, live preview, custom colors, dot styles, and center emojis with SVG/PNG exports.",
  },
  zh: {
    title: "QR 生成器 | 极简自定义二维码生成器",
    description: "纯客户端二维码生成工具。Monolith UI 组件，实时预览，支持自定义点阵样式、调色板及中心表情，具备 SVG/PNG 矢量导出。",
  },
  es: {
    title: "QR Maker | Generador de Códigos QR Personalizados",
    description: "Herramienta de generación de códigos QR del lado del cliente sin registro. Componentes Monolith UI, vista previa en tiempo real y exportación SVG/PNG.",
  },
};

const pt = pageText[lang] || pageText.en;
const title = pt.title;
const description = pt.description;

const uiText: Record<string, Record<string, string>> = {
  ja: {
    contentLabel: "URL / テキスト",
    placeholderText: "https://... またはテキストを入力",
    clearLabel: "入力をクリア",
    preview: "プレビュー",
    dots: "ドット",
    dotStyleAria: "ドットの形状",
    color: "色",
    fgColor: "前景色",
    bgColor: "背景色",
    fgPickerAria: "前景色カラーピッカー",
    bgPickerAria: "背景色カラーピッカー",
    transparent: "背景を透過",
    center: "中央",
    centerModeAria: "中央の表示モード",
    none: "なし",
    emoji: "絵文字",
    text: "テキスト",
    centerTextAria: "中央の文字",
    emojiWarning: "絵文字モードは絵文字1文字向けです。",
    size: "サイズ",
    emojiSizeAria: "絵文字のサイズ",
    hue: "色相",
    emojiHueAria: "絵文字の色相",
    font: "フォント",
    fontAria: "中央文字のフォント",
    weight: "太さ",
    weightAria: "中央文字の太さ",
    advanced: "詳細",
    ec: "誤り訂正",
    ecAria: "誤り訂正レベル",
    resolution: "解像度",
    margin: "余白",
    cornerRadius: "角丸",
    cornerRadiusAria: "QRコードの角丸",
    clear: "消去",
    clearAria: "入力を消去",
    share: "共有",
    shareAria: "設定URLを共有",
    saveSvgAria: "SVGで保存",
    savePng: "PNGで保存",
    history: "履歴",
    textWarning: "日本語などのマルチバイト文字は、読み取り機器によって文字化けすることがあります。",
  },
  en: {
    contentLabel: "URL / Text",
    placeholderText: "https://... or enter text",
    clearLabel: "Clear input",
    preview: "Preview",
    dots: "Dots",
    dotStyleAria: "Dot style",
    color: "Color",
    fgColor: "Foreground",
    bgColor: "Background",
    fgPickerAria: "Foreground color picker",
    bgPickerAria: "Background color picker",
    transparent: "Transparent",
    center: "Center",
    centerModeAria: "Center display mode",
    none: "None",
    emoji: "Emoji",
    text: "Text",
    centerTextAria: "Center text",
    emojiWarning: "Emoji mode works best with a single emoji.",
    size: "Size",
    emojiSizeAria: "Emoji size",
    hue: "Hue",
    emojiHueAria: "Emoji hue",
    font: "Font",
    fontAria: "Center text font",
    weight: "Weight",
    weightAria: "Center text font weight",
    advanced: "Advanced",
    ec: "Error correction",
    ecAria: "Error correction level",
    resolution: "Resolution",
    margin: "Margin",
    cornerRadius: "Corner radius",
    cornerRadiusAria: "QR corner radius",
    clear: "Clear",
