    placeholderText: "https://... 或输入文本",
    clearLabel: "清空输入",
    preview: "预览",
    dots: "点阵",
    dotStyleAria: "点阵样式",
    color: "颜色",
    fgColor: "前景色",
    bgColor: "背景色",
    fgPickerAria: "前景色拾色器",
    bgPickerAria: "背景色拾色器",
    transparent: "背景透明",
    center: "中心",
    centerModeAria: "中心显示模式",
    none: "无",
    emoji: "表情",
    text: "文本",
    centerTextAria: "中心文字",
    emojiWarning: "表情模式建议仅使用单个表情。",
    size: "大小",
    emojiSizeAria: "表情大小",
    hue: "色相",
    emojiHueAria: "表情色相",
    font: "字体",
    fontAria: "中心文字字体",
