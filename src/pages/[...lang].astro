    weightAria: "中心文字粗细",
    advanced: "高级设置",
    ec: "容错级别",
    ecAria: "容错级别",
    resolution: "分辨率",
    margin: "边距",
    cornerRadius: "圆角",
    cornerRadiusAria: "二维码圆角",
    clear: "清空",
    clearAria: "清空输入",
    share: "分享",
    shareAria: "分享配置链接",
    saveSvgAria: "保存为 SVG",
    savePng: "保存为 PNG",
    history: "历史记录",
    textWarning: "部分扫描设备可能会对多字节字符出现乱码。",
  },
  es: {
    contentLabel: "URL / Texto",
    placeholderText: "https://... o escribe un texto",
    clearLabel: "Borrar entrada",
    preview: "Vista previa",
    dots: "Puntos",
    dotStyleAria: "Estilo de puntos",
    color: "Color",
    fgColor: "Primer plano",
    bgColor: "Fondo",
    fgPickerAria: "Selector de color de primer plano",
    bgPickerAria: "Selector de color de fondo",
    transparent: "Fondo transparente",
    center: "Centro",
    centerModeAria: "Modo de visualización central",
    none: "Ninguno",
    emoji: "Emoji",
    text: "Texto",
    centerTextAria: "Texto central",
    emojiWarning: "El modo emoji funciona mejor con un solo emoji.",
    size: "Tamaño",
    emojiSizeAria: "Tamaño del emoji",
    hue: "Tono",
    emojiHueAria: "Tono del emoji",
    font: "Fuente",
    fontAria: "Fuente del texto central",
    weight: "Grosor",
    weightAria: "Grosor del texto central",
    advanced: "Avanzado",
    ec: "Corrección de errores",
    ecAria: "Nivel de corrección de errores",
    resolution: "Resolución",
    margin: "Margen",
    cornerRadius: "Radio de esquinas",
    cornerRadiusAria: "Radio de esquinas del código QR",
    clear: "Borrar",
    clearAria: "Borrar entrada",
    share: "Compartir",
    shareAria: "Compartir enlace de configuración",
    saveSvgAria: "Guardar SVG",
    savePng: "Guardar PNG",
    history: "Historial",
    textWarning: "Los caracteres multibyte pueden aparecer distorsionados en algunos lectores.",
  },
};

const u = uiText[lang] || uiText.en;
---

<Layout title={title} description={description} lang={lang}>
  <div class="page">
    <main class="studio">
      <h1 class="sr-only">QR MAKER</h1>

      <!-- QR preview -->
      <section class="preview-area" aria-label={u.preview}>
        <div class="preview-sticky">
          <div id="qr-preview" class="qr-holder">
            <div class="qr-loading"><Icon name="rotate" /></div>
          </div>
          <div id="readability-alert" class="contrast-banner hidden" role="status">
            <span id="alert-icon" class="banner-icon"></span>
            <span id="alert-text" class="banner-text"></span>
          </div>
        </div>
      </section>

      <!-- URL / Text input (below QR) -->
      <section class="field input-field" aria-label={u.contentLabel}>
        <div class="input-header">
          <label for="input-data" class="label">{u.contentLabel}</label>
        </div>
        <div class="input-container" id="input-container">
          <textarea
            id="input-data"
            placeholder={u.placeholderText}
            class="hero-input"
            rows="1"
            spellcheck="false"
            autocomplete="off"
          ></textarea>
          <button
            type="button"
            id="btn-input-clear"
            class="input-clear-btn hidden"
            aria-label={u.clearLabel}
            title={u.clearLabel}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p id="text-warning" class="note hidden">
          {u.textWarning}
        </p>
      </section>

      <!-- All settings (statically expanded) -->
      <section class="options">
        <div class="options-body">
          <div class="field">
            <span class="label">{u.dots}</span>
            <div class="monolith-radio-group" role="radiogroup" aria-label={u.dotStyleAria}>
              <label class="monolith-radio-item">
                <input type="radio" name="dotStyle" value="square" />
                <div class="monolith-radio-box"><div class="monolith-radio-dot"></div></div>
                <span>Square</span>
              </label>
              <label class="monolith-radio-item">
                <input type="radio" name="dotStyle" value="dots" />
                <div class="monolith-radio-box"><div class="monolith-radio-dot"></div></div>
                <span>Dots</span>
              </label>
              <label class="monolith-radio-item">
                <input type="radio" name="dotStyle" value="rounded" checked />
                <div class="monolith-radio-box"><div class="monolith-radio-dot"></div></div>
                <span>Rounded</span>
              </label>
            </div>
            <select id="input-style" class="hidden" aria-hidden="true" tabindex="-1">
              <option value="square">Square</option>
              <option value="dots">Dots</option>
              <option value="rounded" selected>Rounded</option>
            </select>
          </div>

          <div class="field">
            <span class="label">{u.color}</span>
            <div class="color-row">
              <label class="swatch" title={u.fgColor}>
                <input type="color" id="input-fg" value="#000000" aria-label={u.fgPickerAria} />
                <input type="text" id="input-fg-text" value="#000000" maxlength="7" spellcheck="false" class="hex" aria-label={u.fgColor} />
              </label>
              <label class="swatch" title={u.bgColor}>
                <input type="color" id="input-bg" value="#ffffff" aria-label={u.bgPickerAria} />
                <input type="text" id="input-bg-text" value="#ffffff" maxlength="7" spellcheck="false" class="hex" aria-label={u.bgColor} />
              </label>
              <label class="monolith-checkbox-label">
                <input type="checkbox" id="input-transparent" />
                <div class="monolith-checkbox-box">
                  <svg class="monolith-checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span>{u.transparent}</span>
              </label>
            </div>
          </div>

          <div class="field">
            <span class="label">{u.center}</span>
            <div class="center-row">
              <div class="monolith-radio-group" role="radiogroup" aria-label={u.centerModeAria}>
                <label class="monolith-radio-item">
                  <input type="radio" name="emojiMode" value="none" checked />
                  <div class="monolith-radio-box"><div class="monolith-radio-dot"></div></div>
                  <span>{u.none}</span>
                </label>
                <label class="monolith-radio-item">
                  <input type="radio" name="emojiMode" value="image" />
                  <div class="monolith-radio-box"><div class="monolith-radio-dot"></div></div>
                  <span>{u.emoji}</span>
                </label>
                <label class="monolith-radio-item">
                  <input type="radio" name="emojiMode" value="text" />
                  <div class="monolith-radio-box"><div class="monolith-radio-dot"></div></div>
                  <span>{u.text}</span>
                </label>
              </div>
              <div id="emoji-input-wrap" class="hidden">
                <input type="text" id="input-emoji" value="🌟" class="monolith-input emoji-input" maxlength="50" aria-label={u.centerTextAria} />
              </div>
            </div>
            <select id="input-emoji-mode" class="hidden" aria-hidden="true" tabindex="-1">
              <option value="none" selected>None</option>
              <option value="image">Image</option>
              <option value="text">Text</option>
            </select>
            <p id="emoji-warning" class="note hidden">
              {u.emojiWarning}
            </p>

            <div id="emoji-common-controls" class="grid-2 hidden">
              <div class="slider" id="emoji-size-wrap">
                <div class="slider-head"><span class="label">{u.size}</span><span id="val-emoji-size" class="val">40%</span></div>
                <Slider id="input-emoji-size" min="10" max="50" value="40" ariaLabel={u.emojiSizeAria} />
              </div>
              <div class="slider hidden" id="emoji-hue-wrap">
                <div class="slider-head"><span class="label">{u.hue}</span><span id="val-emoji-hue" class="val">0°</span></div>
                <Slider id="input-emoji-hue" min="0" max="360" value="0" ariaLabel={u.emojiHueAria} />
              </div>
            </div>
            <div id="emoji-text-controls" class="grid-2 hidden">
              <div class="slider" id="emoji-font-wrap">
                <span class="label">{u.font}</span>
                <Select
                  id="input-emoji-font"
                  ariaLabel={u.fontAria}
                  options={[
                    { value: "sans-serif", label: "Sans-serif", selected: true },
                    { value: "serif", label: "Serif" },
                    { value: "monospace", label: "Monospace" },
                    { value: "'Space Mono', monospace", label: "Space Mono" },
                    { value: "'Quicksand', sans-serif", label: "Quicksand" }
                  ]}
                />
              </div>
              <div class="slider" id="emoji-weight-wrap">
                <div class="slider-head"><span class="label">{u.weight}</span><span id="val-emoji-weight" class="val">700</span></div>
                <Slider id="input-emoji-weight" min="100" max="900" step="100" value="700" ariaLabel={u.weightAria} />
              </div>
            </div>
          </div>

          <div class="field">
            <span class="label">{u.advanced}</span>
            <div class="grid-2">
              <div class="slider">
                <span class="label">{u.ec}</span>
                <Select
                  id="input-ec"
                  ariaLabel={u.ecAria}
                  options={[
                    { value: "L", label: "L · 7%" },
                    { value: "M", label: "M · 15%", selected: true },
                    { value: "Q", label: "Q · 25%" },
                    { value: "H", label: "H · 30%" }
                  ]}
                />
              </div>
              <div class="slider">
                <div class="slider-head"><span class="label">{u.resolution}</span><span id="label-size" class="val">256px</span></div>
                <Select
                  id="input-size"
                  ariaLabel={u.resolution}
                  options={[
                    { value: "128", label: "128 × 128" },
                    { value: "256", label: "256 × 256", selected: true },
                    { value: "512", label: "512 × 512" },
                    { value: "1024", label: "1024 × 1024" }
                  ]}
                />
              </div>
              <div class="slider">
                <div class="slider-head"><span class="label">{u.margin}</span><span id="label-margin" class="val">5%</span></div>
                <Slider id="input-margin" min="0" max="25" value="5" ariaLabel={u.margin} />
              </div>
              <div class="slider">
                <div class="slider-head"><span class="label">{u.cornerRadius}</span><span id="val-qr-radius" class="val">10%</span></div>
                <Slider id="input-qr-radius" min="0" max="100" value="10" ariaLabel={u.cornerRadiusAria} />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Floating / Inline Actions (Download, Share, Clear) -->
      <div class="fab-row">
        <button type="button" id="btn-clear" class="fab-circle" aria-label={u.clearAria} title={u.clear}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
        </button>
        <button type="button" id="btn-share" class="fab-circle" aria-label={u.shareAria} title={u.share}>
          <Icon name="share" />
        </button>
        <button type="button" id="btn-dl-svg" class="fab-circle fab-text" aria-label={u.saveSvgAria} title="SVG">SVG</button>
        <button type="button" id="btn-dl-png" class="fab-pill">
          <span class="fab-pill-label">{u.savePng}</span>
          <Icon name="download" />
        </button>
      </div>

      <!-- History (collapsible) -->
      <details id="history-section" class="history-details" style="display: none;">
        <summary class="history-summary">
          <span class="label">{u.history}</span>
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div id="history-list" class="history-list-box"></div>
      </details>
    </main>
  </div>

  <script src="../scripts/main.ts"></script>
</Layout>

<style>
  .page {
    flex: 1;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .studio {
    width: 100%;
    max-width: 640px;
    min-height: 100dvh;
    position: relative;
    padding: 2.5rem 1.25rem 7.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  @media (min-width: 520px) {
    .studio {
      padding: 3.5rem 2rem 5rem;
      gap: 0;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* URL / Content Input */
  .input-field {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.75rem;
  }
  @media (min-width: 520px) {
    .input-field {
      margin-bottom: 3.25rem;
    }
  }

  .input-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .input-container {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.25rem 0 0.875rem;
    border: none;
    border-bottom: 1px solid var(--border-input);
    background-color: transparent;
    transition: border-bottom-color var(--transition-fast);
    cursor: text;
  }

  .input-container:hover {
    border-bottom-color: var(--muted-foreground);
  }

  .input-container:focus-within {
    border-bottom-color: var(--foreground);
    background-color: transparent;
    box-shadow: none;
  }


  .hero-input {
    flex: 1;
    min-height: 1.75rem;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--foreground);
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    padding: 0;
    caret-color: var(--foreground);
    field-sizing: content;
    overflow: hidden;
  }

  .hero-input::placeholder {
    color: var(--muted-foreground);
    opacity: 0.5;
  }

  @media (min-width: 640px) {
    .hero-input {
      font-size: 1.5rem;
    }
  }

  .input-clear-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border: none;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    border-radius: 9999px;
    flex-shrink: 0;
    padding: 0;
    transition: color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
  }

  .input-clear-btn:hover {
    color: var(--foreground);
    background-color: var(--border);
  }

  .input-clear-btn:active {
    transform: scale(0.9);
  }

  .input-clear-btn.hidden {
    display: none;
  }

  .note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-foreground);
    margin-top: 0.5rem;
  }

  /* Preview */
  .preview-area {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-bottom: 2.25rem;
  }
  @media (min-width: 520px) {
    .preview-area {
      margin-bottom: 2.75rem;
    }
  }

  .preview-sticky {
    width: 100%;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
  }

  .qr-holder {
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    border-radius: var(--rounded-qr-frame, 12px);
    background-color: transparent;
    box-shadow: 0 0 0 1px var(--border), 0 8px 30px -4px rgba(0, 0, 0, 0.12);
    transition: border-radius var(--transition-fast), box-shadow var(--transition-fast);
  }
  :global(.dark) .qr-holder {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12), 0 12px 36px -4px rgba(0, 0, 0, 0.6);
  }
  .qr-holder :global(svg),
  .qr-holder :global(img),
  .qr-holder :global(canvas) {
    width: 100% !important;
    height: 100% !important;
    display: block;
    aspect-ratio: 1 / 1;
  }

  .qr-loading {
